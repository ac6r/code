# 复制本文件为 .env 并填入 AI 密钥，四个快速会话对象即可自动回复。
# 配置哪个用哪个：优先 DeepSeek，其次豆包；都没有则退回内置离线回复。

# ---------- 方案一：DeepSeek（推荐）----------
# 密钥申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
# 可选：接口地址 / 模型，一般不用改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------- 方案二：豆包（火山方舟 Ark）----------
# 密钥申请：https://console.volcengine.com/ark
# ARK_API_KEY=你的方舟APIKey
# 模型名，或推理接入点 id（ep- 开头）二选一
# ARK_MODEL=doubao-pro-32k
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------- 可选：强制指定使用哪个提供商 ----------
# 取值：deepseek 或 doubao
# AI_PROVIDER=deepseek
